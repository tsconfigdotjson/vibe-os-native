<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- VibeOS.app under the hardened runtime: it scripts Terminal, to open or
     raise the window attached to an agent (PRD: How a click becomes a
     Terminal window), which the hardened runtime allows only with this. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
