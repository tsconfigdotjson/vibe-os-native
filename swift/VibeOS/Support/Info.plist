<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>VibeOS</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.tsconfigdotjson.VibeOS</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VibeOS</string>
	<!-- AppIcon.svg, checked in as AppIcon.iconset; scripts/sign-macos.sh makes the .icns. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.6</string>
	<!-- The version again: Sparkle compares builds by it, and a release's
	     only goes up. scripts/release-macos.sh checks both against
	     Cargo.toml's. -->
	<key>CFBundleVersion</key>
	<string>0.1.6</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- Asked the first time a row is clicked: Terminal is scripted to
	     open, or raise, the window attached to that agent. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>VibeOS opens Terminal attached to an agent's session, and brings forward the window already attached to it.</string>
	<!-- Shown when macOS asks for Local Network access: the app asks the
	     first time a Linux host being added is on the local network, and
	     vibed's ssh to it counts as the app's (PRD: Adding a Linux host). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>VibeOS connects over SSH to the Linux hosts you add, including ones on your local network.</string>
	<!-- A menu bar app: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
</dict>
</plist>
