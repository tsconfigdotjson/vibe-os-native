    "jsonrpc": "2.0",
    "id": 157,
    "method": "pi.forget",
    "params": {
      "host": "local",
      "providers": [
        "xai"
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 157,
    "result": {
      "host": "local",
      "logins": [
        "openai"
      ],
      "native": {
        "path": "/usr/local/bin/pi",
        "version": "1.5.0"
      },
      "vms": {
        "logins": [
          "anthropic"
        ],
        "version": "1.5.0"
      }
    }
  }
}
